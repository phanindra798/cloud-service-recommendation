# Copy to .env and fill in. NEVER commit the real .env file.
#   cp .env.example .env
# docker compose reads .env automatically; for running the backend without
# Docker, export the same variables in your shell.

# ── Required ─────────────────────────────────────────────────
# JWT signing secret, at least 32 bytes. Left blank on purpose: the app
# refuses to start until you set one. Generate with:
#   openssl rand -base64 48
JWT_SECRET=

# ── Recommended ──────────────────────────────────────────────
# Google Gemini API key — https://aistudio.google.com (free tier, no card).
# Without it you get a baseline recommendation instead of an AI one.
GEMINI_API_KEY=

# ── Docker Compose (defaults shown) ──────────────────────────
# POSTGRES_USER=csr
# POSTGRES_PASSWORD=csrpass
# POSTGRES_DB=csrdb
# APP_PORT=3000           # the app is served at http://localhost:$APP_PORT
# COOKIE_SECURE=true      # set false only for plain-http access on a non-localhost host

# ── Running the backend without Docker ───────────────────────
# DB_URL=jdbc:postgresql://localhost:5432/csrdb
# DB_USERNAME=csr
# DB_PASSWORD=csrpass

# ── Optional ─────────────────────────────────────────────────
# PORT=8080
# LOG_FORMAT=ecs          # structured JSON logs: ecs (default), logstash or gelf
# FORWARD_HEADERS_STRATEGY=none   # "native" behind a reverse proxy (compose sets it)
