# Copy to .env (or export in your shell) and fill in real values.
# NEVER commit the real .env file.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/csrdb
DB_USERNAME=csr
DB_PASSWORD=change-me

# Google Gemini API key — https://aistudio.google.com (free tier, no card)
GEMINI_API_KEY=your-gemini-api-key

# JWT signing secret — minimum 32 bytes, generate with e.g.:
#   openssl rand -base64 48
JWT_SECRET=generate-a-random-secret-at-least-32-bytes-long

# Optional
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# PORT=8080
# LOG_FORMAT=ecs        # structured JSON logs: ecs (default), logstash or gelf
